# ==========================================================
# Application
# ==========================================================

APP_NAME=Pomodoro API
SERVICE_NAME=pomodoro-api
APP_VERSION=0.1.0

# development | test | staging | production
ENVIRONMENT=development

# Development ortamında true olabilir.
# Production ortamında mutlaka false olmalıdır.
POMODORO_DEBUG=true

API_V1_PREFIX=/api/v1

# İzin verilen maksimum request body boyutu, byte cinsinden.
MAX_REQUEST_BODY_BYTES=1048576


# ==========================================================
# Logging and observability
# ==========================================================

LOG_LEVEL=DEBUG
LOG_JSON=false
LOG_COLORIZE=true


# ==========================================================
# Local PostgreSQL container
# ==========================================================

POSTGRES_DB=pomodoro
POSTGRES_USER=pomodoro

# Yalnızca local development örneğidir.
POSTGRES_PASSWORD=change-me

POSTGRES_PORT=5434

CORS_ALLOWED_ORIGINS=["http://localhost:52134","http://127.0.0.1:52134"]

# ==========================================================
# Database
# ==========================================================

# Bu değer yalnızca local development içindir.
# Production credential'larını repository'ye eklemeyin.
DATABASE_URL=postgresql+psycopg://pomodoro:change-me@localhost:5432/pomodoro

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Milisaniye cinsinden PostgreSQL statement timeout.
DATABASE_STATEMENT_TIMEOUT_MS=30000


# ==========================================================
# Redis
# ==========================================================

# Redis şu anda development ortamında zorunlu değildir.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=pomodoro
REDIS_REQUIRED=false


# ==========================================================
# CORS, host and proxy
# ==========================================================

CORS_ALLOWED_ORIGINS=["http://localhost:52134","http://127.0.0.1:52134"]

TRUSTED_HOSTS=["localhost","127.0.0.1"]

# Reverse proxy kullanılmıyorsa boş bırakılabilir.
# Production'da yalnızca gerçek proxy IP'lerini ekleyin.
TRUSTED_PROXY_IPS=[]


# ==========================================================
# Rate limiting
# ==========================================================

# Rate limiting daha sonraki fazda etkinleştirilebilir.
RATE_LIMIT_ENABLED=false

# Redis kullanılamadığında request'lere izin verilip
# verilmeyeceğini belirler.
RATE_LIMIT_FAIL_OPEN=true


# ==========================================================
# JWT and authentication
# ==========================================================

# Aşağıdaki değerler yalnızca local development örneğidir.
# Production secret'larını secret manager veya deployment
# platformunun secret mekanizması üzerinden sağlayın.
JWT_SECRET_KEY=change-me
REFRESH_TOKEN_PEPPER=change-me

JWT_ALGORITHM=HS256
JWT_ISSUER=pomodoro-api
JWT_AUDIENCE=pomodoro-app

ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=30