# ==========================================================
# Application
# ==========================================================

APP_NAME=Pomodoro API
SERVICE_NAME=pomodoro-api
APP_VERSION=0.1.0

# development | test | staging | production
ENVIRONMENT=development

# Production ortamında mutlaka false olmalıdır.
POMODORO_DEBUG=true

API_V1_PREFIX=/api/v1

# İzin verilen maksimum request body boyutu, byte cinsinden.
MAX_REQUEST_BODY_BYTES=1048576


# ==========================================================
# Logging and observability
# ==========================================================

LOG_LEVEL=DEBUG
LOG_JSON=false
LOG_COLORIZE=true


# ==========================================================
# Local PostgreSQL container
# ==========================================================

POSTGRES_DB=pomodoro
POSTGRES_USER=pomodoro

# Yalnızca local development örneğidir.
POSTGRES_PASSWORD=change-me

# Bilgisayarda kullanılacak PostgreSQL portudur.
POSTGRES_PORT=5434


# ==========================================================
# Database
# ==========================================================

# Port ve parola yukarıdaki container ayarlarıyla aynı olmalıdır.
DATABASE_URL=postgresql+psycopg://pomodoro:change-me@127.0.0.1:5434/pomodoro

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Milisaniye cinsinden PostgreSQL statement timeout.
DATABASE_STATEMENT_TIMEOUT_MS=30000


# ==========================================================
# Local Redis container
# ==========================================================

# Yalnızca local development örneğidir.
REDIS_PASSWORD=change-me

# Bilgisayarda kullanılacak Redis portudur.
# Container içinde Redis her zaman 6379 portunda çalışır.
REDIS_PORT=6380


# ==========================================================
# Redis connection
# ==========================================================

# Port ve parola yukarıdaki container ayarlarıyla aynı olmalıdır.
REDIS_URL=redis://:change-me@127.0.0.1:6380/0

# Redis anahtarlarının uygulama, ortam ve servis prefix'leridir.
REDIS_KEY_PREFIX=pomodoro
REDIS_SERVICE_PREFIX=api

# Hibrit rate-limit kesinti politikası için false kalmalıdır.
# True olursa Redis yokken uygulama startup sırasında açılmaz.
REDIS_REQUIRED=false

REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT_SECONDS=1.0
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
REDIS_HEALTHCHECK_TIMEOUT_SECONDS=1.0
REDIS_POOL_HEALTHCHECK_INTERVAL_SECONDS=30


# ==========================================================
# CORS, trusted hosts and proxy
# ==========================================================

CORS_ALLOWED_ORIGINS=["http://localhost:52134","http://127.0.0.1:52134"]

# Fiziksel telefonla bağlanılacaksa bilgisayarın yerel IP adresi
# gerçek .env dosyasındaki bu listeye ayrıca eklenmelidir.
TRUSTED_HOSTS=["localhost","127.0.0.1"]

# Reverse proxy kullanılmıyorsa boş bırakılır.
# Production'da yalnız gerçek proxy IP veya CIDR ağları eklenmelidir.
# Örnek: ["10.20.0.0/16","172.20.10.15/32"]
TRUSTED_PROXY_IPS=[]


# ==========================================================
# Rate limiting
# ==========================================================

# Redis tabanlı rate-limit sistemini etkinleştirir.
RATE_LIMIT_ENABLED=true

# Gerçek .env dosyasında en az 32 karakterlik rastgele değer olmalıdır.
# JWT_SECRET_KEY ve REFRESH_TOKEN_PEPPER ile aynı olmamalıdır.
RATE_LIMIT_KEY_SALT=change-me

# Redis kesildiğinde worker başına tutulabilecek local bucket sayısıdır.
RATE_LIMIT_LOCAL_MAX_BUCKETS=10000


# ==========================================================
# JWT and authentication
# ==========================================================

# Aşağıdaki değerler yalnız local development örnekleridir.
# Production secret'ları repository'ye eklenmemelidir.
JWT_SECRET_KEY=change-me
REFRESH_TOKEN_PEPPER=change-me

JWT_ALGORITHM=HS256
JWT_ISSUER=pomodoro-api
JWT_AUDIENCE=pomodoro-app

ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=30
