APP_NAME=Pomodoro API
SERVICE_NAME=pomodoro-api
APP_VERSION=0.1.0

ENVIRONMENT=development
POMODORO_DEBUG=true
API_V1_PREFIX=/api/v1

LOG_LEVEL=DEBUG
LOG_JSON=false
LOG_COLORIZE=true

POSTGRES_DB=pomodoro
POSTGRES_USER=pomodoro
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DATABASE_URL=postgresql+psycopg://pomodoro:change-me@localhost:5432/pomodoro

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=pomodoro-api
JWT_AUDIENCE=pomodoro-app

ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=30

REFRESH_TOKEN_PEPPER=change-me
